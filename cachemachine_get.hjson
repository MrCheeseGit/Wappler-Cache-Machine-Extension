{
  type: 'cachemachine_get'
  module: 'cachemachine'
  action: 'get'
  groupTitle: 'Mr Cheese'
  groupIcon: 'fas fa-lg fa-cheese comp-exec'
  title: 'Cache Machine Get'
  icon: 'fas fa-lg fa-download comp-data'
  outputType: 'object'

  help: 'Read scoped cache. Use with Condition on {{step.hit}} — if false, run your query then Cache Machine Set. Bind cache key to {{identity}} for per-user data. Bypass with ?nocache=1 only.'

  dataScheme: [
    {name: 'success', type: 'boolean'}
    {name: 'hit', type: 'boolean'}
    {name: 'data', type: 'text'}
    {name: 'key', type: 'text'}
    {name: 'namespace', type: 'text'}
    {name: 'store', type: 'text'}
    {name: 'bypassed', type: 'boolean'}
    {name: 'error', type: 'text'}
  ]

  dataPickObject: true

  properties: [
    {
      group: 'Settings'
      variables: [
        {
          name: 'actionName'
          optionName: 'name'
          title: 'Name'
          type: 'text'
          required: true
          defaultValue: ''
          baseName: 'cacheGet'
          help: 'Step name for bindings (e.g. {{cacheGet.hit}}, {{cacheGet.data}})'
        }
        {
          name: 'actionOutput'
          optionName: 'output'
          title: 'Output'
          type: 'boolean'
          initValue: true
          defaultValue: false
        }
      ]
    }
    {
      group: 'Cache scope'
      variables: [
        {
          name: 'keyPreset'
          optionName: 'cacheKey'
          title: 'Cache key preset'
          type: 'droplist'
          values: [
            {
              title: 'Custom (use field below)'
              value: ''
              show: ['cacheKeyCustom']
            }
            {
              title: 'Per user ({{identity}})'
              value: '{{identity}}'
              hide: ['cacheKeyCustom']
            }
            {
              title: 'Per IP ({{$_SERVER.REMOTE_ADDR}})'
              value: '{{$_SERVER.REMOTE_ADDR}}'
              hide: ['cacheKeyCustom']
            }
            {
              title: 'Per user + URI'
              value: '{{identity}}:{{$_SERVER.REQUEST_URI}}'
              hide: ['cacheKeyCustom']
            }
          ]
          defaultValue: '{{identity}}'
          help: 'When a preset is selected it wins at runtime — stale custom key text is ignored. Use Custom below for provider-specific bindings.'
        }
        {
          name: 'cacheKeyCustom'
          optionName: 'cacheKeyCustom'
          title: 'Custom cache key'
          type: 'text'
          serverDataBindings: true
          defaultValue: ''
          help: 'Only used when preset is Custom. Ignored when any preset is selected above.'
        }
        {
          name: 'namespacePreset'
          optionName: 'namespace'
          title: 'Namespace preset'
          type: 'droplist'
          values: [
            {
              title: 'Custom or none (type below)'
              value: ''
              show: ['namespaceCustom']
            }
            {
              title: 'userProfile — account / profile'
              value: 'userProfile'
              hide: ['namespaceCustom']
            }
            {
              title: 'userSettings — preferences'
              value: 'userSettings'
              hide: ['namespaceCustom']
            }
            {
              title: 'notifications — alerts / inbox'
              value: 'notifications'
              hide: ['namespaceCustom']
            }
            {
              title: 'dashboard — summary / home data'
              value: 'dashboard'
              hide: ['namespaceCustom']
            }
            {
              title: 'list — tables / paginated lists'
              value: 'list'
              hide: ['namespaceCustom']
            }
            {
              title: 'detail — single record'
              value: 'detail'
              hide: ['namespaceCustom']
            }
            {
              title: 'search — search results'
              value: 'search'
              hide: ['namespaceCustom']
            }
            {
              title: 'lookup — reference / dropdown data'
              value: 'lookup'
              hide: ['namespaceCustom']
            }
            {
              title: 'content — pages / CMS blocks'
              value: 'content'
              hide: ['namespaceCustom']
            }
            {
              title: 'report — heavy / slow reports'
              value: 'report'
              hide: ['namespaceCustom']
            }
          ]
          defaultValue: ''
          help: 'When selected, wins over custom namespace below. Use the same preset on Get, Set, and Clear.'
        }
        {
          name: 'namespaceCustom'
          optionName: 'namespaceCustom'
          title: 'Custom namespace'
          type: 'text'
          serverDataBindings: true
          defaultValue: ''
          help: 'Only used when preset is Custom or none. Ignored when a namespace preset is selected above.'
        }
        {
          name: 'requireScopeKey'
          optionName: 'requireScopeKey'
          title: 'Require non-empty cache key'
          type: 'boolean'
          defaultValue: true
          help: 'Keep enabled on user-specific APIs to prevent accidental global cache.'
        }
      ]
    }
  ]
}
